print("CONVERSOR DE UNIDADES")
print("1. Kilómetros a metros")
print("2. Metros a centímetros")
print("3. Horas a minutos")
print("4. Salir")

opcion = int(input("Seleccione una opción: "))

match opcion:
    case 1:
        valor = float(input("Ingrese los kilómetros: "))
        resultado = valor * 1000
        print("Metros:", resultado)
    case 2:
        valor = float(input("Ingrese los metros: "))
        resultado = valor * 100
        print("Centímetros:", resultado)
    case 3:
        valor = float(input("Ingrese las horas: "))
        resultado = valor * 60
        print("Minutos:", resultado)
    case 4:
        print("Saliendo del conversor")
    case _:
        print("Opción inválida")
