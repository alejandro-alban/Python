sueldo = float(input("Ingrese el sueldo base: "))
productividad = float(input("Ingrese la productividad: "))

if productividad >= 90:
    porcentaje = 0.20
elif productividad >= 70:
    porcentaje = 0.10
elif productividad >= 50:
    porcentaje = 0.05
else:
    porcentaje = 0

bono = sueldo * porcentaje
total = sueldo + bono

print("Bono:", bono)
print("Total a pagar:", total)
