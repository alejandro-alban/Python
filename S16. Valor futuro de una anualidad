import java.util.Scanner;

public class S16 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double D, i, VF, total;
          int n;

        System.out.print("Ingrese el depósito mensual: ");
          D = sc.nextDouble();

        System.out.print("Ingrese la tasa mensual: ");
          i = sc.nextDouble();

        System.out.print("Ingrese el número de meses: ");
          n = sc.nextInt();

          total = D * n;
          VF = D * (Math.pow(1 + i, n) - 1) / i;

        System.out.println("Total depositado: " + total);
        System.out.println("Valor futuro: " + VF);
    }
}
