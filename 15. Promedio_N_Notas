n = int(input("Ingrese la cantidad de notas: "))

suma = 0

for i in range(1, n + 1):
    nota = float(input("Ingrese la nota: "))
    suma = suma + nota

if n > 0:
    promedio = suma / n
    print("El promedio de las notas es:", promedio)
else:
    print("La cantidad de notas debe ser mayor que cero")
